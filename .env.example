# Keel API — HTTP Server (Hono)
# Get these from your Supabase dashboard → Project Settings → API
SUPABASE_URL=https://hmcowpwfefeeossztuem.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Note: Use service_role key (NOT anon key) — find it under Project Settings > API > service_role key
PORT=3001

# Comma-separated list of origins allowed to call this API from a browser.
# UNSET MEANS `*` - the code fails open. This is defence in depth, not the access
# control: identity comes from the site token, and a token is only ever scoped to
# its own shop. But a `*` policy does not stop a curl caller, so set it to your
# real storefront hosts.
# ALLOWED_ORIGINS=https://kikoi-opal.vercel.app,https://zuri.vercel.app

# Groq API key. Gates POST /api/chat/answer and POST /api/content/captions;
# both return 500 {error:"GROQ_API_KEY not configured"} when it is absent.
# GROQ_API_KEY=gsk_...

# Keel MCP Server — AI agent tools (npm run mcp)
# Uses the same SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as above.
# Each tool call requires a shop_id parameter for tenant isolation.
# Run: npm run mcp
# Connect your AI client via stdio:
# {
#   "mcpServers": {
#     "keel": {
#       "command": "node",
#       "args": ["src/mcp-cli.js"],
#       "env": { "SUPABASE_URL": "...", "SUPABASE_SERVICE_ROLE_KEY": "..." }
#     }
#   }
# }
